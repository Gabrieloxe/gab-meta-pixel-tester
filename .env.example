# Your Meta Pixel ID — get it from Facebook Events Manager
VITE_META_PIXEL_ID=YOUR_PIXEL_ID_HERE
# ─── Conversions API (CAPI) — server-side only ────────────────────────────────
# System user token from Meta Business Manager (never exposed to browser)
CAPI_ACCESS_TOKEN=
# ─── CAPI Test Mode ──────────────────────────────────────────────────────────
# Paste the test code from Events Manager > Test Events tab
VITE_CAPI_TEST_EVENT_CODE=
# ─── Audiences (.http requests) ──────────────────────────────────────────────
# Ad Account ID (include the "act_" prefix, e.g. act_123456789)
META_AD_ACCOUNT_ID=
# Custom Audience ID for read/update/delete requests
META_AUDIENCE_ID=
# META_ACCESS_TOKEN
META_ACCESS_TOKEN=
# ─── Marketing API – single-image campaign script ────────────────────────────
# Facebook Page ID used as the "page actor" for ad creatives
META_PAGE_ID=
# Optional pixel ID for ad-level tracking specs (defaults to VITE_META_PIXEL_ID)
META_PIXEL_ID=
