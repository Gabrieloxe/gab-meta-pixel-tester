# Your Meta Pixel ID — get it from Facebook Events Manager
VITE_PIXEL_ID=YOUR_PIXEL_ID_HERE

# ─── Conversions API (CAPI) — server-side only ────────────────────────────────
# System user token from Meta Business Manager (never exposed to browser)
CAPI_ACCESS_TOKEN=
# Pixel ID for server-side use (can match VITE_PIXEL_ID)
CAPI_PIXEL_ID=

# ─── CAPI Test Mode ──────────────────────────────────────────────────────────
# Paste the test code from Events Manager > Test Events tab
VITE_CAPI_TEST_EVENT_CODE=
